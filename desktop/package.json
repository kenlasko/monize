{
  "name": "monize-desktop",
  "version": "1.21.0",
  "description": "Monize for Windows: the Electron shell that runs the backend, the frontend and a bundled PostgreSQL on one machine",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/electron-main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.splash.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" \"resources/**/*.cjs\" --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.splash.json",
    "test": "jest && node --test \"scripts/**/*.test.mjs\"",
    "stage": "node scripts/stage.mjs",
    "smoke:postgres": "npm run build && node scripts/smoke-postgres.mjs",
    "dev:boot": "npm run build && node scripts/dev-boot.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "16.15.0-beta.19",
    "@embedded-postgres/windows-x64": "16.15.0-beta.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "electron": "45.3.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
