# Monize Environment Configuration
#
# Copy this file to .env and update the values:
#   cp .env.example .env
#
# Development:  docker compose up -d
# Production:   docker compose -f docker-compose.prod.yml up -d

# ==============================================
# Database
# ==============================================

POSTGRES_DB=monize
POSTGRES_USER=monize_user
POSTGRES_PASSWORD=changeme_in_production

# Enable TLS to the PostgreSQL server (managed databases like RDS, Neon, etc.).
# Default: connections are unencrypted (suitable for local docker networks).
# DATABASE_SSL=true
# When DATABASE_SSL=true, set to 'false' to skip certificate verification --
# useful for self-signed certs in dev. Defaults to true (verify).
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ----------------------------------------------
# Row-Level Security (RLS) -- defense-in-depth
# ----------------------------------------------
# Off by default; leave these unset for the standard single-role setup. RLS adds
# database-enforced per-user isolation beneath the existing app-level filtering.
# See docs/future-plans/row-level-security.md and the runbook for the rollout.
#
# RLS_MODE: off | shadow | enforce (default: off, same as unset)
#   off      Pre-RLS behavior. Runtime connects as POSTGRES_USER (the owner). No
#            identity variables are set. Byte-for-byte identical to no RLS.
#   shadow   Per-transaction identity variables are emitted, but the runtime is
#            still the owner (policies bypassed). Exercises the mechanism safely.
#   enforce  Runtime connects as the unprivileged DATABASE_APP_USER role and RLS
#            policies apply. Requires DATABASE_APP_PASSWORD (boot refuses without
#            it). Only flip to enforce after following the runbook.
# RLS_MODE=off
#
# DATABASE_APP_USER: name of the unprivileged runtime role (default: monize_app).
# It is created (or its password rotated) automatically on startup when
# DATABASE_APP_PASSWORD is set and the owner has CREATEROLE. On managed Postgres
# without CREATEROLE (e.g. CNPG), provision it declaratively instead (CNPG
# Cluster spec.managed.roles) -- startup then only applies its grants.
# DATABASE_APP_USER=monize_app
#
# DATABASE_APP_PASSWORD: password for the runtime role. Required for
# RLS_MODE=enforce; when set (in any mode) the role is created/rotated on
# startup. CAVEAT: with Postgres log_statement='all' (enabled during the staging
# soak per the runbook), bind parameters are logged, so the password can appear
# in DB logs -- rotate it after that phase or scrub the logs.
# DATABASE_APP_PASSWORD=

# ==============================================
# Application
# ==============================================

NODE_ENV=production

# JWT Authentication
# REQUIRED: Generate a secure secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m

# Encryption key for everything Monize stores encrypted at rest: AI provider API
# keys, emergency-access credentials, and the copy of your password that your
# automatic backups are encrypted with.
# STRONGLY RECOMMENDED, and REQUIRED IN A FUTURE RELEASE (minimum 32
# characters). Today the backend starts without it and warns on every boot;
# while it is unset, automatic backups are written UNENCRYPTED, AI provider keys
# cannot be stored, and emergency access cannot be enabled.
# Generate with: openssl rand -hex 32
#
# KEEP THIS VALUE SAFE, AND KEEP IT THE SAME. Changing or losing it does not
# re-encrypt anything -- every secret already stored becomes unreadable, and
# automatic backups stop until each user signs in again. Back it up wherever you
# keep your other deployment secrets.
#
# Formerly AI_ENCRYPTION_KEY. That name is still read (and still wins if both are
# set), so an existing deployment upgrades without re-keying anything; set
# ENCRYPTION_KEY to the SAME value if you want to move over.
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ==============================================
# URLs & Ports
# ==============================================

# Docker host port mappings
# Backend accessible at http://localhost:3000
# Frontend accessible at http://localhost:3001
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Public URL where the frontend is accessible
# Production example: https://your-domain.com
PUBLIC_APP_URL=http://localhost:3001

# CORS allowed origin (should match PUBLIC_APP_URL)
CORS_ORIGIN=http://localhost:3001

# Set to 'true' if accessing Monize directly via HTTP without a reverse proxy.
# Disables Cross-Origin-Opener-Policy and Strict-Transport-Security headers.
# DISABLE_HTTPS_HEADERS=false

# ==============================================
# Authentication
# ==============================================

# Local email/password auth (set to 'false' for OIDC-only)
LOCAL_AUTH_ENABLED=true

# Allow new account registration (set to 'false' to lock down)
REGISTRATION_ENABLED=true

# Force all local users to set up 2FA
FORCE_2FA=false

# Number of days the "Remember Me" session lasts (default: 30)
# Without "Remember Me", sessions last 1 day.
# REMEMBER_ME_DAYS=30

# ==============================================
# OIDC / OpenID Connect (Optional)
# ==============================================

# Leave empty to disable OIDC and use only local authentication.
# Supports: Pocket-ID, Authentik, Authelia, any standard OIDC provider.
#
# OIDC_ISSUER_URL: Provider's base URL (NOT the .well-known URL)
#   Pocket-ID:  https://pocket-id.example.com
#   Authentik:  https://auth.example.com/application/o/your-app/
#   Authelia:   https://auth.example.com
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Callback URL must point to the backend API
OIDC_CALLBACK_URL=http://localhost:3000/api/v1/auth/oidc/callback

# OIDC_REQUIRE_VERIFIED_EMAIL (default true): require the provider to assert
# `email_verified` before trusting the OIDC email. With it true, an OIDC login
# only merges into an existing local (password) account after an email
# confirmation step (needs SMTP). Set to 'false' to trust the IdP email even
# without `email_verified` and merge directly into a matching account, no
# confirmation/SMTP needed. Lowers security -- only disable if you trust your
# IdP to verify email ownership. Note: with it disabled, an already-linked
# user's stored email also follows the (unverified) IdP email on subsequent
# logins, so a misconfigured/compromised IdP can change it.
OIDC_REQUIRE_VERIFIED_EMAIL=true

# OIDC_DEBUG (default false): diagnostic toggle. Set to 'true' to log every
# OIDC back-channel HTTP call the library makes (discovery, token exchange,
# userinfo) with its status and response body. Use it only to diagnose 503 or
# non-conformant token responses that never reach the app-level error handler.
# WARNING: it logs response bodies, which include tokens -- leave it off in
# normal operation and unset it once the problem is diagnosed.
# OIDC_DEBUG=false

# ==============================================
# Email Notifications (Optional)
# ==============================================

SMTP_HOST=
# Default 587 (STARTTLS). Port 465 selects implicit TLS on its own.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Set to 'true' only for a relay offering implicit TLS on a port other
# than 465. It cannot switch implicit TLS off; port 465 has no
# cleartext phase to fall back to.
SMTP_SECURE=

# ==============================================
# Demo Mode (Optional)
# ==============================================

# Set to 'true' to run Monize in demo mode.
# Demo mode uses a fixed login (demo@monize.com / Demo123!),
# disables registration, password changes, and profile editing,
# and resets all data daily at 4:00 AM UTC.
DEMO_MODE=false

# ==============================================
# MCP / OAuth Debug Logging (Optional)
# ==============================================

# Enables per-request tracing of the MCP and OAuth surface
# (/api/v1/mcp, /oauth/*, /oauth-consent/*, /.well-known/oauth-*).
# Useful when diagnosing remote-connector handshake failures with
# Claude Desktop, mcp-remote, or similar MCP clients. Off by default
# because it's verbose. Secrets in request bodies (client_secret,
# code, refresh_token, access_token, code_verifier) are redacted.
# OAUTH_DEBUG_LOG=false

# Maximum write operations (create/update/delete) a single user can perform
# per day through MCP tools, shared across all MCP write tools. A soft
# guardrail that bounds how much an external AI tool can mutate financial data
# per day. Must be a positive integer; falls back to the default if unset or
# invalid. (default: 50)
# MCP_DAILY_WRITE_LIMIT=50

# ==============================================
# AI Integration (Optional)
# ==============================================

# (Moved to the Required Settings section at the top of this file, as
# ENCRYPTION_KEY. AI_ENCRYPTION_KEY is the former name and is still accepted.)

# Optional: System-level default AI provider -- the "centrally managed" AI,
# used for any user who has configured no provider of their own. Users who add
# their own provider in Settings -> AI override it entirely, budgets included.
# AI_DEFAULT_PROVIDER=       # 'anthropic', 'openai', 'ollama', 'openai-compatible'
# AI_DEFAULT_MODEL=          # Default model for the provider
# AI_DEFAULT_API_KEY=        # System-wide API key (if admin wants to provide one)
# AI_DEFAULT_BASE_URL=       # For Ollama or compatible endpoints

# ----------------------------------------------
# Google Places (optional) -- payee contact lookup
# ----------------------------------------------
# A payee's website, address and phone can be looked up from Google's business
# directory instead of from an AI provider. Where Places is configured it
# REPLACES the AI lookup; when the monthly request limit below is reached, the
# lookup falls back to AI if the user has a provider configured.
#
# There are two possible owners of the key, and this one is the OPERATOR's:
# setting it here makes Places available to every user on this deployment, who
# then see only an on/off switch. Leave it unset and each user may configure
# their own key in Settings -> Payee lookup, with their own limit.
# GOOGLE_PLACES_API_KEY=

# Requests per calendar month against the key above before lookups fall back to
# AI. The default is 1000 because a lookup asks for websiteUri and
# internationalPhoneNumber, which Google bills at the Text Search
# "Enterprise SKU" -- whose free allowance is 1,000 requests per month. (The
# widely quoted 10,000 belongs to the Essentials SKU, which returns neither of
# those fields and so cannot answer this lookup at all.)
# Must be a positive integer; an invalid value is logged and the default used.
# GOOGLE_PLACES_MONTHLY_CAP=1000
#
# Restricting the key: use an IP address restriction, not an HTTP referrer one.
# Monize calls Google from the server, and a referrer restriction only protects
# a key that is public (shipped in browser JavaScript, where the browser sets
# the header and page script cannot forge it) -- anything holding this key can
# send any referrer it likes. If your deployment has no stable egress IP, a
# referrer restriction is still workable: PUBLIC_APP_URL's origin is sent as the
# Referer, so add exactly that value (note that *.example.com/* does not match a
# bare example.com).

# Maximum AI provider configurations per user (default: 10)
# AI_MAX_PROVIDERS_PER_USER=10

# Maximum write operations (create/update/delete) a single user can perform
# per day via the AI Assistant action-confirmation endpoint. Mirrors
# MCP_DAILY_WRITE_LIMIT. Must be a positive integer; falls back to the default
# if unset or invalid. (default: 50)
# AI_DAILY_WRITE_LIMIT=50

# ----------------------------------------------
# AI Assistant per-query budgets (centrally managed provider only)
# ----------------------------------------------
# Resource ceilings for a single AI Assistant question. When one is hit the
# assistant stops and answers from whatever it has gathered so far, which the
# user sees as a "reached the maximum number of analysis steps" style message.
#
# THESE APPLY ONLY TO THE CENTRALLY MANAGED PROVIDER configured above with
# AI_DEFAULT_PROVIDER. A provider a user configured for themselves carries its
# own budgets on its configuration, edited per provider in Settings -> AI, and
# falls back to the defaults below -- never to these variables. An operator
# sizing the loop for the model they host is saying nothing about the model
# somebody else pointed at their own Ollama box.
#
# The defaults suit a hosted frontier model, which plans several tool calls per
# turn. A smaller local model (Ollama) tends to issue one lookup per turn and
# can run out of analysis steps mid-investigation -- raise
# AI_QUERY_MAX_ITERATIONS first if you see that message often.
#
# Each must be a positive integer; an invalid value is ignored, logged at warn
# on startup, and the default is used.

# Analysis steps: trips through the tool-calling loop. Usually the first limit
# reached, because a model that calls one tool per turn spends one step per
# lookup. (default: 5)
# AI_QUERY_MAX_ITERATIONS=5

# Total data lookups (tool calls) per query, summed across all steps.
# (default: 15)
# AI_QUERY_MAX_TOOL_CALLS=15

# Wall-clock budget for one query, in minutes. Independent of the provider's
# own timeout -- raise it for slow CPU-only local inference. (default: 20)
# AI_QUERY_TIMEOUT_MINUTES=20

# Cumulative input tokens across all steps of one query. The main cost control
# for paid providers; lower it to cap per-question spend. (default: 200000)
# AI_QUERY_MAX_INPUT_TOKENS=200000

# Characters kept from a single tool result before it is truncated. Guards the
# context window against one oversized lookup. Raising it lets the model see
# larger result sets at the cost of consuming the token budget faster.
# (default: 50000)
# AI_QUERY_MAX_TOOL_RESULT_CHARS=50000

# ==============================================
# Attachments
# ==============================================

# Storage backend for transaction attachment bytes.
#   database (default) -- store bytes in PostgreSQL (no external storage needed)
#   local              -- store bytes on the local filesystem (see ATTACHMENT_CONTAINER_DIR)
#   s3                 -- store bytes in S3-compatible object storage (see ATTACHMENT_S3_* below)
# ATTACHMENT_STORAGE_PROVIDER=database

# --- local provider ---------------------------------------------------------
# Folder inside the backend container where the "local" provider writes
# attachment files (one per attachment). Must be writable and persistent.
# Replaces ATTACHMENT_LOCAL_DIR, which still works but logs a deprecation
# warning at startup.
# ATTACHMENT_CONTAINER_DIR=/data/attachments

# Host folder mapped to ATTACHMENT_CONTAINER_DIR by the docker-compose files, so
# attachments survive the container being recreated. Relative paths are resolved
# against this file's directory.
# ATTACHMENT_HOST_DIR=./monize/attachments

# --- s3 provider ------------------------------------------------------------
# Bucket name (required when ATTACHMENT_STORAGE_PROVIDER=s3).
# ATTACHMENT_S3_BUCKET=my-monize-attachments
# Region (defaults to us-east-1; many S3-compatible services ignore it).
# ATTACHMENT_S3_REGION=us-east-1
# Optional key prefix so attachments share a bucket with other data.
# ATTACHMENT_S3_PREFIX=attachments/
# Custom endpoint for S3-compatible services (MinIO, Cloudflare R2, Backblaze
# B2, ...). Leave unset for AWS S3.
# ATTACHMENT_S3_ENDPOINT=http://minio:9000
# Set true for path-style addressing (required by MinIO and some others).
# ATTACHMENT_S3_FORCE_PATH_STYLE=false
# Credentials. If omitted, the default AWS credential chain is used
# (instance role, shared config, AWS_* env vars, ...).
# ATTACHMENT_S3_ACCESS_KEY_ID=
# ATTACHMENT_S3_SECRET_ACCESS_KEY=
# How long one S3 operation may run end to end before it is aborted, in
# milliseconds. Defaults to 300000 (5 minutes), and may only be SHORTENED: a
# larger value is clamped back down, because the attachment orphan sweeper's
# late-write quarantine assumes a PutObject cannot still be in flight when the
# window passes. Lower it to fail faster against an unreliable endpoint.
# ATTACHMENT_S3_REQUEST_TIMEOUT_MS=300000

# ==============================================
# Backup
# ==============================================

# Folder inside the backend container where automatic backups are written.
# It is the default shown in Settings -> Automatic Backup, which only an
# administrator can see; an admin can point it somewhere else there. Every
# other user is enrolled automatically on this folder and the default schedule
# and retention policy. The folder is created on first use, so only its parent
# has to exist in the container.
#
# Each user's backups go in their own folder underneath it, fanned out by user
# id the same way attachments are: <base>/<ab>/<cd>/<user-id>/. The filenames
# carry only a tier and a date, so without that folder two users' backups for
# the same day would be the same file.
#
# Backups are encrypted with the user's own password whenever the server holds
# a usable copy of it -- captured when they sign in, so a local-auth user has
# nothing to switch on (Settings -> Backup & Restore shows the state, and can
# capture the password from a session that predates the feature). Accounts that
# sign in through OIDC have no password of ours, so they set a dedicated backup
# password there (or leave their backups unencrypted). The key this copy is
# stored under is derived from JWT_SECRET, so no extra configuration is needed;
# AI_ENCRYPTION_KEY is used instead wherever one is set.
# BACKUP_CONTAINER_DIR=/data/backups

# Host folder mapped to BACKUP_CONTAINER_DIR by the docker-compose files, so
# backups survive the container being recreated. Relative paths are resolved
# against this file's directory.
# BACKUP_HOST_DIR=./monize/backups

# Maximum accepted size of an uploaded backup on restore. A backup embeds
# transaction attachment bytes for EVERY provider -- "database" bytes come
# straight from the table, and "local"/"s3" objects are read at export time and
# carried base64-encoded in the artifact -- so this may need raising for large
# datasets whichever provider is configured.
#
# That is what makes an artifact self-contained: a restore stages the carried
# bytes back through whatever provider this runtime uses (so a backup taken under
# one provider restores under another), verifying the size and SHA-256 the backup
# recorded, and the source directory or bucket does not have to be backed up
# separately. An attachment is reported as skipped -- never restored as metadata
# pointing at nothing -- when the artifact carried no usable bytes for it: the
# object was missing or failed its checksum at export time, or the artifact
# predates self-contained backups and carries only metadata.
#
# Those older artifacts need more than the sidecar store: the restore reads their
# bytes from the CURRENT instance, and only after checking that this user already
# owns a transaction_attachments row with the same id, provider, size and SHA-256
# (the file never gets the last word about which objects it may read). On a fresh
# instance no such rows exist, so every external attachment is skipped even if the
# directory or bucket was restored perfectly. A pre-5a578061 artifact is therefore
# restorable only onto an instance that still has its own attachment metadata --
# export a fresh backup to get one that stands alone.
#
# Unset, this derives from the container's memory limit and follows
# BACKUP_RESTORE_EXPANDED_LIMIT below -- deliberately. gzip output is never smaller
# than what it expands to, so an upload above the expanded ceiling is one this
# deployment could never decompress; refusing it before the body is buffered beats
# refusing it afterwards. The two used to be derived separately, which let a 66 MiB
# upload be accepted against a 100 MiB expanded ceiling it would then blow past on
# decompression.
#
# It follows the expanded ceiling DOWN but not up: raising
# BACKUP_RESTORE_EXPANDED_LIMIT raises what this deployment will attempt to
# decompress, not what it can buffer, and express.raw puts the body on the heap
# before anything can refuse it. Set this one explicitly if you mean to raise it.
#
# On the chart's default 400Mi backend that derives to about 23 MiB. It used to be
# 66 MiB, and before that the literal 500mb below -- both from a model that assumed
# a restore costs three times its expanded payload and nothing fixed. Measured, it
# costs about 6.1 times the payload PLUS a fixed 78 MiB (issue #1073), so those
# numbers admitted restores the process cannot finish -- and on a pod with less than
# about 78 MiB free after the baseline, no restore fits at all.
# Raising this without raising the container's memory limit does not make a larger
# restore work; it makes the failure an OOM kill instead of a refusal.
#
# Accepts any value the `bytes` library understands (e.g. 500mb, 2gb).
# BACKUP_RESTORE_LIMIT=28mb

# Directories automatic backups may be written under, colon-separated like PATH.
# Defaults to BACKUP_CONTAINER_DIR alone.
#
# Backup destinations used to be any absolute writable path, chosen through an
# endpoint that required authentication and no role -- so any user could browse
# the container filesystem and point their backups at /tmp, a mounted secret, or
# another tenant's directory. Paths are now canonicalised (so a symlink inside a
# permitted directory cannot lead out of one) and confined to these roots.
#
# If your users had chosen folders outside BACKUP_CONTAINER_DIR, list them here;
# until you do, those backups are refused with an error naming this variable.
#
# Within a root, each user's backups go in a server-computed subdirectory named by
# their user id. Files already sitting directly in a root predate this, carry no
# owner in their names, and are deliberately left alone -- retention only ever
# enumerates a per-user directory, so nothing deletes them and nothing guesses
# whose they are.
# BACKUP_ALLOWED_ROOTS=/data/backups:/mnt/nas/monize

# Ceilings on the backup paths that hold a whole payload in memory.
#
# Unset, the backend derives each one from this container's cgroup memory limit
# rather than from a fixed number -- a quarter of it for the export buffer, and for
# the two restore ceilings the memory left after the ordinary process is reserved,
# divided by the measured cost of a restore. That matters: these
# used to default to 1024mb and 512mb while the Helm chart's backend limit is
# 400Mi, so neither ceiling could ever fire -- the pod was OOM-killed first, which
# is the outcome they exist to prevent. A ceiling has to be smaller than the
# process it protects, and only the container knows how big that is.
#
# Set them when you have measured your own deployment. The backend logs a warning
# at startup when a configured value is too large to protect the process, because
# the failure mode there is a restart rather than a rejected request.
#
# BACKUP_RESTORE_EXPANDED_LIMIT bounds a restore's DECOMPRESSED payload;
# BACKUP_RESTORE_LIMIT bounds the compressed upload and says nothing about what
# comes out of gzip, since a few hundred kilobytes of repeated text expands to
# gigabytes. BACKUP_EXPORT_BUFFER_LIMIT bounds the artifact an in-memory export
# holds: the automatic backup writes a file, and the support export needs every
# table at once to reconcile scaled balances. Both HTTP downloads stream -- the
# encrypted one included, since it writes a framed container rather than one
# AES-GCM message over the whole artifact -- so neither is bounded by it.
#
# On Kubernetes set these through backend.backupLimits in values.yaml, beside
# resources.limits.memory, so the two cannot drift apart.
# BACKUP_RESTORE_EXPANDED_LIMIT=28mb
# BACKUP_EXPORT_BUFFER_LIMIT=96mb

# How many restores may WAIT for a processing slot, and for how long.
#
# Restore processing is capped separately from the upload, because a small gzip
# expands to the expanded ceiling regardless of its wire size -- on the default
# pod the cap is one, so a second restore waits. Waiting rather than being
# refused outright is deliberate: the caller has already uploaded the artifact,
# and a 503 makes them upload it again.
#
# But a wait that is neither bounded nor deadlined holds a socket and the
# upload's memory reservation for as long as the client keeps them, so both
# bounds exist. A request arriving at a full queue, or one whose wait runs out,
# is refused with 503 and a Retry-After. A caller who disconnects while queued
# is dropped and its restore never runs.
#
# BACKUP_RESTORE_QUEUE_LIMIT=4
# BACKUP_RESTORE_QUEUE_WAIT_MS=120000

# --- backup off-site copies -------------------------------------------------
# After a complete automatic backup has been written locally, a copy of the same
# artifact can be placed off the machine, so losing the backup volume is not
# losing every recovery point. Two destinations, enabled per user in Settings
# and independent of each other (a 3-2-1 arrangement): an S3 bucket and an
# email attachment. Everything below is OFF until it is configured here or by
# the user, and only an ENCRYPTED artifact is ever copied off the machine.
#
# The local artifact stays primary: it is written first, it is what restore
# reads, and nothing here ever replaces or deletes it.

# --- s3 egress default destination (append-only) ---
# Bucket the deployment offers its users. Setting it is what makes the
# "deployment" destination available at all; with it unset, a user choosing
# that destination is refused at save time with an error naming this variable.
# A user may instead configure their own bucket and their own credentials.
# BACKUP_S3_BUCKET=my-monize-offsite
# Region (defaults to us-east-1; many S3-compatible services ignore it).
# BACKUP_S3_REGION=us-east-1
# Optional key prefix so backups share a bucket with other data. Normalised to
# one trailing slash, like ATTACHMENT_S3_PREFIX.
# BACKUP_S3_PREFIX=backups/
# Custom endpoint for S3-compatible services (MinIO, Cloudflare R2, Backblaze
# B2, ...). Leave unset for AWS S3.
# BACKUP_S3_ENDPOINT=http://minio:9000
# Set true for path-style addressing (required by MinIO and some others).
# BACKUP_S3_FORCE_PATH_STYLE=false
# Credentials for the bucket above. Set both or neither: with neither, the
# default AWS credential chain is used (instance role, shared config, AWS_*
# env vars, ...), which is how a deployment on EC2 or EKS reaches its own
# bucket.
#
# GIVE THIS TOKEN AN APPEND-ONLY POLICY. Its IAM policy grants s3:PutObject and
# s3:AbortMultipartUpload ONLY -- no s3:DeleteObject, no s3:GetObject -- on a
# bucket with versioning and object lock enabled (or the equivalent write-once
# rule your provider offers), so a leaked token cannot delete or rewrite an
# existing recovery point. The application matches that from its side: it never
# deletes an object and every put is conditional ("this key must not already
# exist"), so even a mis-scoped token cannot overwrite a copy that is already
# there. s3:AbortMultipartUpload is in the policy because it discards the parts
# of an INCOMPLETE upload, which is not object deletion; without it a failed
# upload leaves parts accumulating and billable.
#
# Retention off-machine is therefore YOURS, through the bucket's lifecycle or
# object-lock policy. The application never ages a copy out.
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# How long one S3 operation may run end to end before it is aborted, in
# milliseconds. Defaults to 300000 (5 minutes) and may only be SHORTENED: a
# larger value is clamped back down, the same ceiling the attachment provider
# is held to.
# BACKUP_S3_REQUEST_TIMEOUT_MS=300000
# Bytes per part of a multipart upload, and therefore the size above which an
# artifact is uploaded in parts rather than in one request. S3 requires at
# least 5242880 (5 MiB) per part, so a smaller value is raised back to it with
# a warning. (default: 16777216 = 16 MiB)
# BACKUP_S3_MULTIPART_PART_BYTES=16777216

# --- email egress ---
# The largest artifact emailed as an attachment. Above this the user is sent a
# notice naming the artifact, its size and this bound, with no bytes attached
# and no download link (a link would need a read credential this feature
# deliberately does not hold). Raise it only if you know your relay accepts
# larger messages. (default: 20971520 = 20 MiB)
# BACKUP_EMAIL_MAX_BYTES=20971520

# ==============================================
# Quote Providers
# ==============================================

# MSN Money / Bing Finance API key used by MsnFinanceService when fetching
# live quotes. The default is the public Microsoft/Peregrine key used by
# MSN Money web widgets. Change this if Microsoft rotates the key or if you have your own.
MSN_API_KEY=0QfOX3Vn51YCzitbLaRkTTBadtWpgTN8NZLW0C1SEM

# ==============================================
# Update Checks
# ==============================================

# Controls whether the backend periodically polls GitHub for new Monize
# releases and shows admin users an in-app "update available" banner.
# Set to 'false' to disable the check entirely (no outbound calls to
# api.github.com). Default: true.
# UPDATE_CHECK_ENABLED=true

# ==============================================
# Microsoft Money (.mny) Import
# ==============================================

# Largest .mny file the import wizard accepts, in megabytes. A Money Plus
# Sunset file with three decades of history runs to a couple of hundred MB.
# Peak memory during an import is roughly twice the file size, so a pod
# importing a 300 MB file wants at least 1 GB. Default: 300.
# MNY_IMPORT_LIMIT_MB=300
#
# Set this on the FRONTEND container too. The Next.js proxy caps a forwarded
# request body at 10MB by default and truncates anything larger without an
# error, so an unset frontend limit makes any Money file over 10MB fail as an
# aborted upload. The frontend also buffers the body, so it needs about this
# much memory available on top of its baseline.

# Private UnifiedPush distributors: operator-only exact HTTPS origin -> pinned IP.
# Empty by default. Restart backend after changes. Dedicated distributor origins only.
# IP must be RFC1918 IPv4 or IPv6 ULA; no loopback/link-local/metadata/public IPs.
# DNS names only; certificate verification remains enabled for that name.
# UNIFIEDPUSH_PRIVATE_ENDPOINTS='{"https://ntfy.home.lan":"192.168.20.5"}'

# Notification reminder cron limits (per replica; restart backend after changes).
# Maximum claims per minute: integer 1..10000. Backlog stays due for later ticks.
# NOTIFICATION_REMINDER_CLAIM_BATCH=100
# Maximum concurrent re-emits: integer 1..100. Increase with delivery capacity.
# NOTIFICATION_REMINDER_REEMIT_CONCURRENCY=5

# ==============================================
# Frontend - Local Development Only
# ==============================================

# These are set automatically by docker-compose.
# Only needed when running 'next dev' outside Docker.
# If used, copy to frontend/.env.local instead of setting here.
#
# INTERNAL_API_URL=http://localhost:3000
# NEXT_PUBLIC_LOG_LEVEL=info
