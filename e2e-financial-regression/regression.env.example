# Monize financial regression harness -- configuration.
#
# Copy this file to `regression.env` (git-ignored) and fill it in. The harness
# refuses to run without `regression.env`. Nothing here is read from your
# shell environment automatically; the harness loads THIS file explicitly.
#
# ---------------------------------------------------------------------------
# SAFETY ACKNOWLEDGEMENT (required)
# ---------------------------------------------------------------------------
# This harness reads a real, existing Monize database through the browser.
# Point it at a DISPOSABLE COPY of your data, never at production. Setting this
# to `yes` confirms you understand the run is read-only and the target DB is a
# throwaway copy. The preflight aborts if this is not exactly `yes`.
I_UNDERSTAND_THIS_IS_READ_ONLY_ON_A_DISPOSABLE_DB=no

# ---------------------------------------------------------------------------
# REVISIONS TO COMPARE (Docker orchestration mode)
# ---------------------------------------------------------------------------
# git refs (tag, branch, or commit SHA) for the two revisions. BEFORE is run
# first, always. AFTER may apply a forward schema migration to your copy DB.
MONIZE_BEFORE_REF=main
MONIZE_AFTER_REF=pr/06-unknown-is-not-zero

# ---------------------------------------------------------------------------
# EXTERNAL DATABASE (the pre-existing copy to read)
# ---------------------------------------------------------------------------
# The harness NEVER creates, drops, resets, or seeds this database. It must
# already exist and already contain the data you want to compare against.
# From inside the app containers, "localhost" is the container, not your host:
# use `host.docker.internal` to reach a database running on your machine.
MONIZE_DB_HOST=host.docker.internal
MONIZE_DB_PORT=5432
MONIZE_DB_NAME=monize_copy
MONIZE_DB_USER=monize_user
MONIZE_DB_PASSWORD=

# Refuse a non-local database host unless this is `yes`. A remote host is a
# strong signal you are about to read something you should not.
MONIZE_ALLOW_REMOTE_DB=no

# ---------------------------------------------------------------------------
# EXISTING USER TO LOG IN AS
# ---------------------------------------------------------------------------
# The harness logs in as this existing user through the UI and reads what they
# see. It does not register, seed, or modify the account.
MONIZE_USER_EMAIL=
MONIZE_USER_PASSWORD=
# Optional: the user's TOTP (2FA) shared secret, base32. Leave blank if 2FA is
# off for this account. Used only to compute a login code; never stored.
MONIZE_USER_TOTP_SECRET=

# ---------------------------------------------------------------------------
# APP SECRETS (must match how your copy DB was created / will boot)
# ---------------------------------------------------------------------------
# JWT_SECRET must be >= 32 chars (enforced by the app at startup). If your copy
# DB stores encrypted data tied to a specific AI_ENCRYPTION_KEY, set it too.
MONIZE_JWT_SECRET=regression-harness-jwt-secret-min-32-characters
MONIZE_AI_ENCRYPTION_KEY=

# Host ports the harness will expose each revision on (frontend / backend).
# Defaults avoid the dev/e2e ports (3001/3000) so a running dev stack is safe.
MONIZE_FRONTEND_PORT=4801
MONIZE_BACKEND_PORT=4800

# ---------------------------------------------------------------------------
# MANUAL / URL MODE (optional -- skip Docker orchestration)
# ---------------------------------------------------------------------------
# If you start each revision yourself, set these and use the per-phase
# invocation documented in the README instead of `npm run compare`.
MONIZE_BEFORE_URL=
MONIZE_AFTER_URL=
